{
  "name": "@dash-ota/cli",
  "version": "0.6.1",
  "description": "Release tooling for dash-ota: keygen, fingerprint, bundle, encrypt+sign, publish, and rollout ops. Holds the Ed25519 signing key (CI/release only). npx-executable.",
  "type": "module",
  "bin": {
    "dash-ota": "dist/index.mjs"
  },
  "files": [
    "dist",
    "dash-ota.config.example.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Scripting-Bear/dash-ota.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "devDependencies": {
    "@dash-ota/shared": "^0.4.0",
    "esbuild": "^0.24.2",
    "@dash-ota/backend": "^0.5.0"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --packages=bundle --external:@mongodb-js/zstd --outfile=dist/index.mjs --banner:js=\"#!/usr/bin/env node\" && node -e \"require('node:fs').copyFileSync('src/dashboard/ui.html','dist/ui.html')\"",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@mongodb-js/zstd": "^7.0.0"
  },
  "homepage": "https://scripting-bear.github.io/dash-ota/",
  "bugs": {
    "url": "https://github.com/Scripting-Bear/dash-ota/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
